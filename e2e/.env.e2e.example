# Copy to e2e/.env.e2e (gitignored) and fill in. Run every e2e command from the repo root.
# Never prefix these with NEXT_PUBLIC_: that would ship them to the browser bundle.
# Quote values that contain #, $ or spaces: E2E_USER_PASSWORD='p@ss#word$1'
# Variables already set in the process (CI secrets) win over this file.

# Which environment profile to target (see e2e/config/environments). Default: hybrid.
E2E_PROFILE=hybrid

# Optional: frontend URL override. Must be allowed by the profile. Empty = use the profile's.
E2E_BASE_URL=

# Dedicated e2e user of a dedicated company (the services are shared with production).
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Company the user must belong to. Any write is aborted if the logged-in company differs.
E2E_COMPANY_ID=

# Specs tagged @writes-olva register REAL shipments in Olva. Off unless you set true.
E2E_ALLOW_REAL_SHIPMENTS=false
